# Copy to app/.env.local and fill in. Never commit the real file.
JEV_API_KEY=
JEV_API_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# IMAP development settings (leave blank in git; fill only in app/.env.local)
# IMAP_PRESET is "icloud" or "generic". iCloud needs an app-specific password, never the Apple ID password.
IMAP_PRESET=
IMAP_HOST=
IMAP_PORT=
# "implicit" (TLS from the start) or "starttls". Plaintext is not supported.
IMAP_TLS=
IMAP_USER=
IMAP_PASSWORD=
# Optional: OAuth2 access token. If set, XOAUTH2 is tried first, then the password.
IMAP_ACCESS_TOKEN=
# Seconds between polls when the server has no IDLE (default 45).
IMAP_POLL_SECONDS=
